# Copy this file to .env  ->  cp env.example .env

# Riot API key. Development keys expire every 24h; a Personal key does not.
# Get one at https://developer.riotgames.com
RIOT_API_KEY=RGAPI-xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx

# Data source for the refresh worker: "mock" | "riot"
# Use "mock" to develop the UI without burning rate limit.
DATA_SOURCE=mock
