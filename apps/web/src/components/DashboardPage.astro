---
/**
 * The shell every section shares.
 *
 * `/`, `/live`, `/shells` and the rest are separate prerendered documents so a
 * refresh or a shared link lands on real HTML, but all of them mount the same
 * island with the same snapshot — so moving between sections inside the page is
 * a pushState, with nothing refetched and nothing remounted.
 */
import Layout from '../layouts/Layout.astro';
import { Dashboard } from './Dashboard';
import { loadSnapshotAtBuild } from '../lib/api';

const snapshot = await loadSnapshotAtBuild();
const { tournament } = snapshot;
const playerCount = snapshot.players.length;
---

<Layout
  title={`${tournament.name}${tournament.edition ? ` · ${tournament.edition}` : ''}`}
  description={tournament.subtitle ||
    'Tabla del challenge privado de SoloQ, actualizada automáticamente.'}
>
  <div class="mx-auto w-full max-w-[1500px] px-4 pb-16 sm:px-6">
    <header class="pt-10 pb-8 sm:pt-14">
      <p class="eyebrow" style="color: var(--color-accent)">
        {tournament.edition || 'Tabla en vivo'} · {playerCount} jugadores
      </p>

      <h1
        class="display mt-3 text-fluid-2xl leading-[0.92] tracking-tight uppercase"
      >
        {tournament.name}
      </h1>

      {
        tournament.subtitle && (
          <p class="mt-3 max-w-xl text-fluid-base text-ink-2">
            {tournament.subtitle}
          </p>
        )
      }

      <div
        class="mt-6 h-px w-full"
        style="background: linear-gradient(90deg, var(--color-accent), transparent 60%)"
      >
      </div>
    </header>

    <Dashboard initialSnapshot={snapshot} client:load />

    <footer class="mt-20 border-t border-line pt-6 text-fluid-xs text-ink-3">
      <p class="mb-4">
        <a
          href="/panel"
          class="eyebrow text-ink-3 transition-colors hover:text-ink"
        >
          Editar roster →
        </a>
      </p>
      <p class="max-w-3xl">
        {tournament.name} no está avalado por Riot Games y no refleja las opiniones
        ni los puntos de vista de Riot Games ni de nadie oficialmente involucrado en la
        producción o gestión de las propiedades de Riot Games. Riot Games y todas sus
        propiedades asociadas son marcas registradas de Riot Games, Inc.
      </p>
    </footer>
  </div>
</Layout>
