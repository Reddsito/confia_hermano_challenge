---
/**
 * The shell for the alternate design at `/demo`.
 *
 * Same island, same snapshot, same sections as the production dashboard — the
 * difference is the theme scope on `<body>` and the chrome around it. Where the
 * live shell opens with a broadcast title card, this one opens with a
 * masthead: rule, nameplate, folio line, rule. A results page from a paper.
 */
import Layout from '../layouts/Layout.astro';
import { Dashboard } from './Dashboard';
import { loadSnapshotAtBuild } from '../lib/api';

const snapshot = await loadSnapshotAtBuild();
const { tournament } = snapshot;
const playerCount = snapshot.players.length;

/** The folio carries the edition date, the way a printed page always does. */
const printedOn = new Intl.DateTimeFormat('es-ES', {
  weekday: 'long',
  day: 'numeric',
  month: 'long',
  year: 'numeric',
}).format(new Date(snapshot.generatedAt));
---

<Layout
  title={`${tournament.name}${tournament.edition ? ` · ${tournament.edition}` : ''} — Clasificación`}
  description={tournament.subtitle ||
    'Tabla del challenge privado de SoloQ, actualizada automáticamente.'}
  bodyClass="theme-press"
  fontHref="https://fonts.googleapis.com/css2?family=Anton&family=Bitter:wght@400;600;700&family=IBM+Plex+Mono:wght@500;600&display=swap"
  themeColor="#f0cbc1"
  colorScheme="light"
>
  <div class="mx-auto w-full max-w-[1500px] px-4 pb-16 sm:px-6">
    <header class="pt-6 sm:pt-10">
      <!-- The press rule: the heaviest horizontal in the design, and the first
           thing on the page. -->
      <div class="h-1.5 w-full" style="background: var(--color-accent)"></div>

      <div
        class="flex flex-wrap items-baseline justify-between gap-x-6 gap-y-1 border-b border-[color:var(--color-line-strong)] py-2"
      >
        <p class="eyebrow" style="color: var(--color-ink-2)">
          {tournament.edition || 'Edición diaria'}
        </p>
        <p class="eyebrow" style="color: var(--color-ink-3)">{printedOn}</p>
      </div>

      <h1
        class="display mt-5 text-fluid-2xl leading-[0.86] tracking-tight sm:mt-7"
      >
        {tournament.name}
      </h1>

      <div
        class="mt-5 flex flex-wrap items-baseline justify-between gap-x-8 gap-y-2 border-t-2 border-b border-[color:var(--color-line-strong)] py-2"
      >
        {
          tournament.subtitle && (
            <p class="max-w-2xl text-fluid-base italic" style="color: var(--color-ink-2)">
              {tournament.subtitle}
            </p>
          )
        }
        <p class="eyebrow shrink-0" style="color: var(--color-accent)">
          {playerCount} jugadores en tabla
        </p>
      </div>
    </header>

    <div class="mt-6">
      <Dashboard initialSnapshot={snapshot} basePath="demo" client:load />
    </div>

    <footer
      class="mt-20 border-t-2 border-[color:var(--color-line-strong)] pt-5 text-fluid-xs"
      style="color: var(--color-ink-3)"
    >
      <div class="mb-5 flex flex-wrap items-center gap-x-6 gap-y-2">
        <a
          href="/panel"
          class="eyebrow transition-colors hover:text-[color:var(--color-accent)]"
        >
          Editar roster →
        </a>
      </div>
      <p class="max-w-3xl">
        {tournament.name} no está avalado por Riot Games y no refleja las opiniones
        ni los puntos de vista de Riot Games ni de nadie oficialmente involucrado en la
        producción o gestión de las propiedades de Riot Games. Riot Games y todas sus
        propiedades asociadas son marcas registradas de Riot Games, Inc.
      </p>
    </footer>
  </div>
</Layout>
