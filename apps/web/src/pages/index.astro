---
/**
 * The public front door between challenges.
 *
 * The dashboard itself lives under `/demo` now, so the root is a held front
 * page: the timing strip, the name, and a lit decal where the board will go
 * once the next challenge starts. It wears the same pit theme as `/demo`,
 * because a placeholder that looks nothing like the product it precedes is
 * just a different site.
 */
import Layout from '../layouts/Layout.astro';
import { SessionCatcher } from '../components/SessionCatcher';
import { loadSnapshotAtBuild } from '../lib/api';

const snapshot = await loadSnapshotAtBuild();
const { tournament } = snapshot;

const printedOn = new Intl.DateTimeFormat('es-ES', {
  weekday: 'long',
  day: 'numeric',
  month: 'long',
  year: 'numeric',
}).format(new Date(snapshot.generatedAt));
---

<Layout
  title={`${tournament.name} — Próximamente`}
  description="El próximo reto del challenge se corre en Norteamérica."
  bodyClass="theme-pit"
  fontHref="https://fonts.googleapis.com/css2?family=Azeret+Mono:wght@500;600&family=Barlow+Condensed:wght@600;700&family=Barlow:wght@400;500;600&display=swap"
  themeColor="#0c0a09"
  colorScheme="dark"
>
  <div
    class="mx-auto flex min-h-screen w-full max-w-[1100px] flex-col px-4 sm:px-6"
  >
    <header class="pt-6 sm:pt-10">
      <div class="h-0.5 w-full" style="background: var(--color-accent)"></div>

      <div
        class="flex flex-wrap items-baseline justify-between gap-x-6 gap-y-1 border-b border-line py-2"
      >
        <p class="eyebrow" style="color: var(--color-ink-2)">
          {tournament.edition || 'Edición especial'}
        </p>
        <p class="eyebrow" style="color: var(--color-ink-3)">{printedOn}</p>
      </div>

      <h1
        class="display mt-6 text-fluid-2xl leading-[0.84] tracking-tight sm:mt-9"
      >
        {tournament.name}
      </h1>

      <div class="mt-6 border-t border-line"></div>
    </header>

    <main
      class="flex flex-1 flex-col items-center justify-center gap-10 py-20 text-center"
    >
      <!-- The stamp: the only rotated element on the page, so it reads as
           something pressed onto the paper rather than typeset with it. -->
      <div
        class="rounded-sm border-2 px-8 py-6 sm:px-14 sm:py-8"
        style="border-color: var(--color-accent); color: var(--color-accent); transform: rotate(-2.5deg); box-shadow: 0 0 40px -14px var(--color-accent)"
      >
        <p class="display text-fluid-xl leading-none tracking-tight">
          Próximamente
        </p>
      </div>

      <p
        class="max-w-xl text-fluid-lg leading-snug italic"
        style="color: var(--color-ink-2)"
      >
        El próximo reto se corre en Norteamérica. Cuando arranque, la
        clasificación se publica aquí.
      </p>

      <div
        class="h-px w-24"
        style="background: var(--color-line-strong)"
      >
      </div>

      <!-- Literal, not `tournament.platform`: the snapshot still describes the
           edition that just finished, and this line is about the next one. -->
      <p class="eyebrow" style="color: var(--color-ink-3)">
        Próximo circuito · <span style="color: var(--color-accent)">NA</span> ·
        SoloQ
      </p>

      <!-- Discord returns here after a sign-in, so the token has to be read on
           this page even though there is no dashboard on it. -->
      <SessionCatcher client:load />
    </main>

    <footer
      class="border-t border-line py-6 text-fluid-xs"
      style="color: var(--color-ink-3)"
    >
      <p class="max-w-3xl">
        {tournament.name} no está avalado por Riot Games y no refleja las opiniones
        ni los puntos de vista de Riot Games ni de nadie oficialmente involucrado
        en la producción o gestión de las propiedades de Riot Games. Riot Games y
        todas sus propiedades asociadas son marcas registradas de Riot Games, Inc.
      </p>
    </footer>
  </div>
</Layout>
