---
import Layout from '../layouts/Layout.astro';
import { Panel } from '../components/Panel';

// No build-time data: everything here is behind the group code and is fetched
// by the island after the code is entered.
---

<Layout
  title="Roster · Confia Hermano Challenge"
  description="Editá los jugadores que sigue el challenge."
>
  <div class="mx-auto w-full max-w-4xl px-4 pb-16 sm:px-6">
    <header class="pt-10 pb-8 sm:pt-14">
      <a
        href="/"
        class="eyebrow text-ink-3 transition-colors hover:text-ink"
        style="letter-spacing: 0.14em"
      >
        ← Back to the leaderboard
      </a>
      <h1
        class="display mt-3 text-fluid-xl leading-[1.05] tracking-tight uppercase"
      >
        Roster
      </h1>
      <p class="mt-2 max-w-xl text-fluid-sm text-ink-2">
        Agregá, renombrá y eliminá las cuentas que sigue el challenge. Los cambios
        se aplican en la próxima actualización.
      </p>
      <div
        class="mt-6 h-px w-full"
        style="background: linear-gradient(90deg, var(--color-accent), transparent 60%)"
      >
      </div>
    </header>

    <Panel client:only="react" />
  </div>
</Layout>
