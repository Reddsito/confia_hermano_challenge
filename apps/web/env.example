# Copy this file to .env  ->  cp env.example .env
#
# Everything here ships to the browser. Never put a secret in this file:
# the Riot API key and the admin token belong to apps/server/.env only.

# Where the backend lives. Defaults to http://localhost:8787, so you can skip
# this file entirely while developing locally.
# In production this is set as an environment variable in Cloudflare Pages.
PUBLIC_API_URL=http://localhost:8787
