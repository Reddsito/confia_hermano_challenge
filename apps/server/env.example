# Copy to .env  ->  cp env.example .env

# ---- data source -------------------------------------------------------
# "mock" runs the whole stack without a Riot key. "riot" hits the real API.
DATA_SOURCE=mock
RIOT_API_KEY=RGAPI-xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx

# Riot platform id, NOT the regional route. euw1 / na1 / la1 / la2 / kr ...
PLATFORM=la1

# ---- server ------------------------------------------------------------
PORT=8787
DATABASE_PATH=./data/challenge.db
REFRESH_INTERVAL_MINUTES=2

# ---- security ----------------------------------------------------------
# Bearer token for /api/admin/*. Generate one: openssl rand -hex 32
# Required whenever DATA_SOURCE=riot.
ADMIN_TOKEN=

# Exact origins allowed to call this API from a browser. The frontend is on
# Cloudflare Pages, so this must list its URL. "*" is for local dev only.
ALLOWED_ORIGINS=https://confia-hermano.pages.dev,http://localhost:4321

# The same ADMIN_TOKEN is the code your group types into /panel once. Share it
# in your group chat; anyone with it can edit the roster.

# ---- discord -----------------------------------------------------------
# This is the only line you need. Server Settings -> Integrations ->
# Webhooks -> New Webhook -> Copy Webhook URL.
# Leave it empty and no notifications are sent; nothing else changes.
DISCORD_WEBHOOK_URL=

# Everything below is optional and already has a sensible default.
#
# DISCORD_EVENTS    which events get posted, comma separated, or "all".
#                   default: match_finished, rank_change, new_leader
#                   the fourth one, in_game, fires every time someone queues
#                   up, so it is off unless you ask for it.
# DISCORD_USERNAME  name the messages are posted under. default: the
#                   tournament name from tournament.config.json.
# DISCORD_AVATAR_URL  picture next to those messages. default: none.
# SITE_URL          public site URL, linked from the messages. default: none.

# ---- discord login (optional) ------------------------------------------
# Only needed so participants can sign in and fire blue shells.
# discord.com/developers/applications -> New Application -> OAuth2.
# Add the callback below to that application's Redirects list.
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
DISCORD_REDIRECT_URI=http://localhost:8787/api/auth/discord/callback

# Signs login sessions. Falls back to ADMIN_TOKEN when unset.
# Changing it signs everyone out.
SESSION_SECRET=
