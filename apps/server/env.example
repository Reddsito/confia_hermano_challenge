# Copy to .env  ->  cp env.example .env

# ---- data source -------------------------------------------------------
# "mock" runs the whole stack without a Riot key. "riot" hits the real API.
DATA_SOURCE=mock
RIOT_API_KEY=RGAPI-xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx

# Riot platform id, NOT the regional route. euw1 / na1 / la1 / la2 / kr ...
PLATFORM=la1

# ---- server ------------------------------------------------------------
PORT=8787
DATABASE_PATH=./data/challenge.db
REFRESH_INTERVAL_MINUTES=2

# ---- security ----------------------------------------------------------
# Bearer token for /api/admin/*. Generate one: openssl rand -hex 32
# Required whenever DATA_SOURCE=riot.
ADMIN_TOKEN=

# Exact origins allowed to call this API from a browser. The frontend is on
# Cloudflare Pages, so this must list its URL. "*" is for local dev only.
ALLOWED_ORIGINS=https://confia-hermano.pages.dev,http://localhost:4321

# The same ADMIN_TOKEN is the code your group types into /panel once. Share it
# in your group chat; anyone with it can edit the roster.

# ---- discord (opcional) ------------------------------------------------
# Server Settings -> Integrations -> Webhooks -> New Webhook -> copy the URL.
# Leave it empty and no notifications are sent; nothing else changes.
DISCORD_WEBHOOK_URL=

# Which events get posted. Comma separated, or "all".
#   match_finished  a game ended, with champion, KDA and LP change
#   rank_change     promoted or demoted a division
#   new_leader      the top of the table changed hands
#   in_game         someone just queued up (noisy — off by default)
# Default when unset: everything except in_game.
DISCORD_EVENTS=match_finished,rank_change,new_leader

# How the bot presents itself in the channel.
DISCORD_USERNAME=
DISCORD_AVATAR_URL=

# Public site URL, linked from the Discord messages.
SITE_URL=
