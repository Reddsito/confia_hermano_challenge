# Add this block to the Caddyfile your existing Caddy container already uses —
# do not start a second Caddy, ports 80 and 443 can only be held once.
#
# The upstream is the container name on the shared Docker network, not a host
# port: the API publishes nothing to the host, so the proxy is the only way in.
#
# After editing:  docker exec <caddy-container> caddy reload --config /etc/caddy/Caddyfile

api.example.com {
	encode zstd gzip

	reverse_proxy challenge-api:8787

	log {
		output file /var/log/caddy/challenge-api.log
		format json
	}
}
